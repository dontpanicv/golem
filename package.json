{
  "name": "golem",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build web/index.html --outdir dist/web --public-path /app/ --production --splitting",
    "dev": "bun run build --watch & bun --watch src/main.ts",
    "format": "ultracite fix",
    "lint": "ultracite check",
    "lint:ios": "cd ios && swiftlint lint --strict --quiet",
    "start": "bun run build && bun src/main.ts",
    "test": "bun test",
    "tokens": "bun scripts/tokens.ts",
    "typecheck": "bun check && bun check -p web"
  },
  "dependencies": {
    "@earendil-works/chord": "^1.4.0",
    "@earendil-works/pi-ai": "^1.4.0",
    "@earendil-works/pi-codemode": "^1.4.0",
    "@earendil-works/pi-durable": "^1.4.0",
    "@effect/platform-bun": "^4.0.6",
    "@tanstack/query-async-storage-persister": "^5.105.0",
    "@tanstack/query-db-collection": "^1.4.8",
    "@tanstack/query-persist-client-core": "^5.105.0",
    "@tanstack/react-db": "^0.5.12",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-router": "^1.170.46",
    "agent-browser": "^0.39.2",
    "better-auth": "^1.7.12",
    "chart.js": "^4.6.1",
    "docx-preview": "^0.4.1",
    "effect": "^4.0.6",
    "fflate": "^0.8.3",
    "idb-keyval": "^6.3.0",
    "jszip": "^3.10.2",
    "pptxviewjs": "^1.1.9",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "read-excel-file": "^9.3.12",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.5.0",
    "unpdf": "^1.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "better-call": "1.4.4",
    "typescript": "^7.0.2",
    "ultracite": "8.0.2"
