// Machine-specific values live in Local.xcconfig (gitignored): DEVELOPMENT_TEAM, GOLEM_BUNDLE_ID, GOLEM_SERVER_URL,
// GOLEM_ASSOCIATED_DOMAIN. GOLEM_ASSOCIATED_DOMAIN is the host of GOLEM_SERVER_URL, where Google sign-in returns; add
// ?mode=developer when Apple's CDN cannot reach the server, as on a VPN (iOS Settings > Developer > Associated Domains
// Development must be on).
GOLEM_BUNDLE_ID = dev.golem.app
DEVELOPMENT_TEAM =
GOLEM_SERVER_URL = http:/$()/localhost:3000
GOLEM_ASSOCIATED_DOMAIN = localhost
#include? "Local.xcconfig"
