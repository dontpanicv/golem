{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/type-aware",
    "ultracite/biome/react",
    "ultracite/biome/tanstack"
  ],
  "files": {
    // Vendored, generated by `bun run tokens`, or managed by Xcode
    "includes": [
      "!public/tokens.css",
      "!ios/Golem/Assets.xcassets",
      "!design/icon.svg"
    ]
  },
  "javascript": {
    "globals": ["Bun", "Float16Array", "HTMLRewriter"]
  },
  "linter": {
    "rules": {
      "performance": {
        // React compares props by identity only for memoized components; inline handlers are React's own idiom
        "noJsxPropsBind": "off",
        // Golem runs on one machine: loops await on purpose so one model, one ffmpeg, and one sync run at a time
        "noAwaitInLoops": "off",
        // JavaScriptCore caches regex literals, and parsers read best with the pattern where it is used
        "useTopLevelRegex": "off"
      },
      "style": {
        // noUncheckedIndexedAccess is on; `!` marks an index or route parameter the code already guarantees
        "noNonNullAssertion": "off",
        // Bun runs TypeScript directly, and services take their dependencies as constructor properties
        "noParameterProperties": "off"
      },
      "suspicious": {
        // Biome's type inference ignores noUncheckedIndexedAccess and fields that change across an await
        "noUnnecessaryConditions": "off",
        // Handlers and stores implement Promise contracts; `async` turns a throw into a rejection
        "useAwait": "off"
      }
    }
  },
  "overrides": [
    {
      // TypeScript checks imports; Biome cannot read the exports of React's type declarations
      "includes": ["web/**"],
      "linter": {
        "rules": { "correctness": { "noUnresolvedImports": "off" } }
      }
    },
    {
      // The React rules are for the web app; the server's `use…` methods are not hooks
      "includes": ["src/**", "test/**", "scripts/**"],
      "linter": {
        "rules": { "correctness": { "useHookAtTopLevel": "off" } }
      }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        // Key order is evaluation order in object literals and cascade order in CSS;
        // interfaces keep the same order as the objects that fill them
        "useSortedKeys": "off",
        "useSortedInterfaceMembers": "off",
        "useSortedProperties": "off"
      }
    }
  }
}
