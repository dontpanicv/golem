  "cards": [
    {
      "dot": "emerald",
      "title": "Members and public",
      "items": [
        "An agent makes a page or small app; it belongs to its channel",
        "Members: only signed-in people who see the channel open it",
        "Public: anyone with the link of four words opens it"
      ]
    },
    {
      "dot": "rose",
      "title": "The sandbox",
      "items": [
        "The HTML runs in a frame without allow-same-origin",
        "It cannot read Golem's cookies or call Golem's API",
        "The content policy blocks fetch; data goes only through golem"
      ]
    },
    {
      "dot": "cyan",
      "title": "The deploy model",
      "items": [
        "Golem listens on 127.0.0.1; cloudflared connects out",
        "The public host passes only artifact paths, else 404",
        "Too many missing links from one address get 429"
      ]
    }
  ]
