  "cards": [
    {
      "dot": "emerald",
      "title": "Pairing",
      "items": [
        "Add machine in your own Settings makes a one-time command",
        "The machine trusts the Ed25519 key of the person who paired it",
        "Golem pins the machine's self-signed certificate"
      ]
    },
    {
      "dot": "rose",
      "title": "Transport",
      "items": [
        "WebSocket over TLS 1.3, one port, closed to anyone unpaired",
        "Nothing but auth is accepted before the signature",
        "Each connection gets its own serve process"
      ]
    },
    {
      "dot": "cyan",
      "title": "Work",
      "items": [
        "Files: read, write, edit, list; commands with exec",
        "Jobs run under a supervisor and outlive the connection",
        "A command that dcg flags waits for the person"
      ]
    }
  ]
